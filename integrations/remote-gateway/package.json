{
  "name": "@qualixar/slm-remote-gateway",
  "version": "0.0.0-preparation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:runtime": "vitest run --config vitest.runtime.config.mts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "jsdom": "24.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "ws": "8.21.0"
  }
}
