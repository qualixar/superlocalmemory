  "mcpName": "io.github.qualixar/superlocalmemory",
  "bugs": {
    "url": "https://github.com/qualixar/superlocalmemory/issues"
  },
  "bin": {
    "slm": "./bin/slm-npm",
    "superlocalmemory": "./bin/slm-npm"
  },
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check",
    "build:copilot-plugin": "node scripts/build-copilot-plugin.mjs",
    "check:copilot-plugin": "node scripts/build-copilot-plugin.mjs --check",
    "build:codex-plugin": "node scripts/build-codex-plugin.mjs",
    "check:codex-plugin": "node scripts/build-codex-plugin.mjs --check",
    "build:plugins": "node scripts/build-all-plugins.mjs",
    "prepack": "node scripts/build-all-plugins.mjs && node scripts/prepack.js",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "test": "node scripts/run-ui-tests.mjs",
    "build:antigravity-plugin": "node scripts/build-antigravity-plugin.mjs",
    "build:muse-plugin": "node scripts/build-muse-plugin.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "bin/slm-npm",
    "ide/completions/",
    "ide/configs/",
    "ide/hooks/",
    "scripts/postinstall.js",
    "scripts/postinstall-interactive.js",
    "scripts/postinstall/validation.js",
    "scripts/postinstall/media-request.js",
    "scripts/postinstall/node-arch.js",
    "scripts/postinstall/engine-upgrade.js",
    "scripts/preuninstall.js",
    ".claude-plugin/",
    "plugin/",
    "cursor-plugin/",
    ".cursor-plugin/",
    "plugin-src/skills/",
    "plugin-src/agents/",
    "plugin-src/commands/",
    "plugin-src/rules/",
    "codex-plugin/",
    "copilot-plugin/",
    "hermes-plugin/",
    "antigravity-plugin/",
    "muse-plugin/",
    "docs/pi-dev-integration.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "preferGlobal": true,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/varun369"
  },
  "maintainers": [
    {
