#!/usr/bin/env bash
# slm-launch — SuperLocalMemory MCP launcher (POSIX)
#
# Cross-platform counterpart: slm-launch.bat (Windows)
# Referenced by .mcp.json as the MCP server command.
#
# WHAT THIS RESOLVES, AND WHY THE DEFAULT CHANGED
#
# It used to default to a venv the plugin owns:
# "${CLAUDE_PLUGIN_DATA}/venv/bin/slm". So anyone who already had SuperLocalMemory
# — from pip, pipx or npm — got a SECOND installation the moment they installed
# the plugin, on its own schedule, upgraded separately, and easy to leave behind
# a release. Installing a plugin should not fork your installation.
#
# It was also Claude-Code-only. ${CLAUDE_PLUGIN_DATA} is set by Claude Code and
# by nothing else, so on Codex or Antigravity the path collapsed to
# "/venv/bin/slm" and the server simply did not start.
#
# The default is now: USE THE SLM THAT IS ALREADY INSTALLED. A plugin-owned venv
# is the fallback for a machine that has none, not the first choice.
#
# Environment (all optional):
#   SLM_LAUNCHER       auto (default) — prefer an installed slm, else the plugin venv
#                      system         — require the slm on PATH
#                      plugin         — require the plugin's own venv
#                      <path>         — an explicit slm binary (leading ~ expanded)
#   SLM_DATA_DIR       SLM data dir (default: ~/.superlocalmemory)
#   CLAUDE_PLUGIN_DATA where a plugin-owned venv lives (then CURSOR_PLUGIN_DATA,
#                      PLUGIN_DATA, then ~/.local/share/superlocalmemory-plugin)
#   SLM_LAUNCHER_BOOTSTRAP=1  build that venv here when nothing else can run
#
# HOSTS THAT DO NOT EXPAND THEIR VARIABLES
#
# Some hosts (Grok Bot's plugin computer) pass ${CLAUDE_PLUGIN_ROOT} and
# ${CLAUDE_PLUGIN_DATA} through literally. So this script finds itself from
# BASH_SOURCE, and treats any value still containing "${" as unset.
#
# Which slm runs, in order: SLM_LAUNCHER; an slm on PATH; the plugin venv, if
# built; uvx, pinned to this plugin's release (CPU-only torch on Linux); and,
# only with SLM_LAUNCHER_BOOTSTRAP=1, a plugin venv built on the spot.
# The daemon is started first and `slm serve start` waits (up to 60 s) for its
# /health, so the first remember after a cold start is not "daemon unavailable".
#
# Deliberately NOT set here: the MCP profile. Which tools a host exposes is the
# user's decision, and a plugin that narrows it takes away tools they configured.

# Where this script lives. Never from ${CLAUDE_PLUGIN_ROOT}: not every host sets it.
_slm_self="${BASH_SOURCE[0]}"
while [ -h "${_slm_self}" ]; do
    _slm_link="$(readlink "${_slm_self}")"
    case "${_slm_link}" in
        /*) _slm_self="${_slm_link}" ;;
        *)  _slm_self="$(dirname "${_slm_self}")/${_slm_link}" ;;
    esac
done
_SLM_SCRIPTS="$(cd "$(dirname "${_slm_self}")" && pwd)"
_SLM_PLUGIN_ROOT="$(dirname "${_SLM_SCRIPTS}")"

# A value that is empty, or a placeholder the host never replaced, is not a value.
_slm_usable() {
    case "$1" in
        ''|*'${'*) return 1 ;;
    esac
    return 0
}
[ -n "${HOME:-}" ] || { HOME="$(cd ~ 2>/dev/null && pwd)"; export HOME; }
_slm_usable "${SLM_DATA_DIR:-}" || unset SLM_DATA_DIR
_slm_usable "${SLM_LAUNCHER:-}" || unset SLM_LAUNCHER
if ! _slm_usable "${CLAUDE_PLUGIN_DATA:-}"; then
    unset CLAUDE_PLUGIN_DATA
    for _slm_d in "${CURSOR_PLUGIN_DATA:-}" "${PLUGIN_DATA:-}" \
                  "${XDG_DATA_HOME:-${HOME}/.local/share}/superlocalmemory-plugin"; do
        if _slm_usable "${_slm_d}"; then CLAUDE_PLUGIN_DATA="${_slm_d}"; break; fi
    done
fi

_SLM_DATA="${SLM_DATA_DIR:-$HOME/.superlocalmemory}"

# Which slm to run is decided in ONE place, shared with the hooks and the venv
# bootstrap, so the three can never disagree about which install is in play.
# shellcheck source=slm-resolve.sh
. "${_SLM_SCRIPTS}/slm-resolve.sh"
_PLUGIN_BIN="$(slm_plugin_bin)"

# Is a daemon already up for this data dir? If so we join it rather than boot a
# second one — one writer for every session that shares the store.
_daemon_running=0
if [ -f "${_SLM_DATA}/daemon.pid" ] \
   && kill -0 "$(cat "${_SLM_DATA}/daemon.pid" 2>/dev/null)" 2>/dev/null; then
    _daemon_running=1
fi

# Start a daemon with the chosen command unless one is already serving.
_ensure_daemon() {
    [ "${_daemon_running}" -eq 1 ] && return 0
    "$@" serve start >&2
}

# No installed slm and no plugin venv: run this release through uvx. Returns
# only when it cannot (no uvx); otherwise it becomes the server. The version is
# written in literally at build time (scripts/build-plugin.mjs replaces
# __SLM_RELEASE__): Anthropic's plugin directory refuses a uvx launch whose pin
# it cannot read, and a pin computed at run time is one it cannot read.
_slm_run_uvx() {
    command -v uvx >/dev/null 2>&1 || return 1
    # PyPI's Linux torch is the CUDA build; macOS and Windows get CPU wheels anyway.
    if [ "$(uname -s 2>/dev/null)" = "Linux" ]; then
        export UV_TORCH_BACKEND="${UV_TORCH_BACKEND:-cpu}"
    fi
    # slm sets its own thread defaults (cli/main.py, mcp/server.py); this
    # launcher sets nothing else (guarded in tests/test_plugin).
    echo "SLM plugin: no installed slm; running superlocalmemory==__SLM_RELEASE__ through uvx (downloaded once, then cached)." >&2
    if [ "${_daemon_running}" -ne 1 ]; then
        uvx --from "superlocalmemory==__SLM_RELEASE__" slm serve start >&2 || \
            echo "SLM plugin: daemon did not start; the MCP server will retry on first use." >&2
    fi
    exec uvx --from "superlocalmemory==__SLM_RELEASE__" slm mcp
}

# Opt-in: build the plugin venv now, with the same bootstrap SessionStart runs.
_slm_bootstrap() {
    [ "${SLM_LAUNCHER_BOOTSTRAP:-0}" = "1" ] || return 1
    CLAUDE_PLUGIN_ROOT="${_SLM_PLUGIN_ROOT}" CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA}" \
        bash "${_SLM_SCRIPTS}/ensure-venv.sh" >&2 || return 1
    [ -x "${SLM_CHOICE_BIN}" ]
}

if ! slm_choose; then
    echo "${SLM_RESOLVE_ERROR}" >&2
    exit 1
fi

case "${SLM_LAUNCHER:-auto}:${SLM_CHOICE}" in
    auto:system)
        # An slm already on PATH — the pip, pipx or npm install the user has.
        # This is the common case and the one that must not be forked.
        #
        # Both orderings end up here, and both must converge on ONE
        # environment:
        #   installed first, plugin second -> nothing was ever forked;
        #   plugin first, installed second -> the plugin venv is now the
        #     older copy and must stop being used.
        # They already share one store, because this launcher sets no
        # SLM_DATA_DIR and both resolve ~/.superlocalmemory. What is left to
        # go wrong is two DIFFERENT VERSIONS serving that one store: whoever
        # starts the daemon first decides which code the other one talks to.
        # So when a leftover plugin venv is found beside a real install, say
        # so, with both versions named. Silent duplication is how a store
        # ends up served by a release nobody thinks they are running.
        if [ -n "${_PLUGIN_BIN}" ] && [ -x "${_PLUGIN_BIN}" ]; then
            _sys_v="$(slm --version 2>/dev/null | awk '{print $NF}')"
            _plg_v="$("${_PLUGIN_BIN}" --version 2>/dev/null | awk '{print $NF}')"
            if [ -n "${_plg_v}" ] && [ "${_sys_v}" != "${_plg_v}" ]; then
                echo "SLM plugin: using the installed slm ${_sys_v:-?} and IGNORING a leftover plugin venv at ${_PLUGIN_BIN} (${_plg_v})." >&2
                echo "  One store, one version. Remove the venv to stop it drifting:  rm -rf \"${CLAUDE_PLUGIN_DATA}/venv\"" >&2
            fi
        fi
        _ensure_daemon "${SLM_CHOICE_BIN}" || \
            echo "SLM plugin: daemon did not start; continuing as a direct MCP writer." >&2
        exec slm mcp
        ;;
    auto:plugin)
        # No system install. Use the plugin's own venv, once SessionStart has
        # built it. A host that runs no hooks never builds it: then uvx, then
        # (opt-in) a venv built here. If none of that works, say what was
        # looked for, so the fix is obvious.
        if [ "${SLM_CHOICE_READY}" -ne 1 ]; then
            _slm_run_uvx
            if ! _slm_bootstrap; then
                slm_not_found_message >&2
                echo >&2
                echo "  Or install uv (Astral's Python package manager): the plugin then runs SuperLocalMemory through uvx." >&2
                exit 1
            fi
        fi
        if ! _ensure_daemon "${SLM_CHOICE_BIN}"; then
            echo "SLM plugin: unable to start the owned daemon; refusing a direct MCP writer." >&2
            exit 1
        fi
        exec "${SLM_CHOICE_BIN}" mcp
        ;;
    system:system)
        _ensure_daemon "${SLM_CHOICE_BIN}" || true
        exec slm mcp
        ;;
    plugin:plugin)
        if ! _ensure_daemon "${SLM_CHOICE_BIN}"; then
            echo "SLM plugin: unable to start the owned daemon; refusing a direct MCP writer." >&2
            exit 1
        fi
        exec "${SLM_CHOICE_BIN}" mcp
        ;;
    *:explicit)
        _ensure_daemon "${SLM_CHOICE_BIN}" || true
        exec "${SLM_CHOICE_BIN}" mcp
        ;;
    *)
        echo "SLM plugin: internal error: unexpected launcher choice '${SLM_LAUNCHER:-auto}:${SLM_CHOICE}'." >&2
        exit 1
        ;;
esac
